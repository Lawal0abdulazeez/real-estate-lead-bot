# Application
APP_ENV=development
APP_NAME=real-estate-lead-bot
APP_VERSION=0.1.0
DEBUG=true

# API
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/real_estate_leads
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/real_estate_leads

# JWT / Auth
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# n8n
N8N_WEBHOOK_URL=http://localhost:5678/webhook
N8N_WEBHOOK_SECRET=change-me-n8n-webhook-secret
N8N_BASE_URL=http://localhost:5678

# AI Provider (example for OpenAI-compatible or other)
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30

# Google Sheets (optional operational sync)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Logging
LOG_LEVEL=INFO
